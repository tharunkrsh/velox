<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VELOX tearsheet · {{ title }}</title>
<style>
{{ styles }}</style>
</head>
<body>
<main id="velox-root"><noscript>This report needs JavaScript to draw its charts. The raw result is embedded as JSON in this file.</noscript></main>
<script type="application/json" id="velox-data">{{ payload }}</script>
<script>{{ renderer }}</script>
<script>
renderVelox(document.getElementById("velox-root"),
            JSON.parse(document.getElementById("velox-data").textContent));
</script>
</body>
</html>
